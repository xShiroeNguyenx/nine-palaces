{
  "name": "@np/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nine-palaces --local",
    "db:migrate:remote": "wrangler d1 migrations apply nine-palaces --remote",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@np/rules": "workspace:*",
    "@np/shared": "workspace:*",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.114.17",
    "ws": "^8.18.0"
  }
}
